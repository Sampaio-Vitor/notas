HOST=127.0.0.1
PORT=4329
TZ=America/Sao_Paulo
# Para acesso externo configure senhas e HTTPS no proxy reverso:
# HOST=0.0.0.0
# Uma pessoa por entrada (id:Nome:senha). A primeira fica com os dados antigos.
# APP_USERS=ana:Ana:uma-senha-longa,bia:Bia:outra-senha-longa
# Ou, com uma pessoa só:
# APP_PASSWORD=uma-senha-longa-e-exclusiva
# PUBLIC_ORIGIN=https://notas.seu-dominio.com
# Agentes com acesso só à lista de compras pelo /mcp (id:token, token com 24+ caracteres).
# Gere com: openssl rand -hex 32
# MCP_TOKENS=lia:troque-por-um-token-longo
# Faturas de cartão do app de finanças, só pela rede Docker notas-financas.
# O token é o mesmo da entrada notas em SERVICE_TOKENS de lá. FINANCE_USER: quem vê os cartões.
# FINANCE_URL=http://finance_api:8000
# FINANCE_TOKEN=troque-por-um-token-longo
# FINANCE_USER=ana
